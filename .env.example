# Bổ sung cho môi trường development (compose.yaml đã có sẵn giá trị dev mặc định).
# Biến đã đặt trong `environment:` của compose.yaml (DATABASE_URL, VALKEY_URL…) thì sửa ở compose.yaml:
# compose ưu tiên chúng hơn file này. Chạy backend ngoài Docker thì backend đọc backend/.env.
# Chép thành `.env` nếu cần. File này KHÔNG dùng cho staging/production — xem deploy/README.md.

# Agent: mặc định OpenAI gpt-4o-mini. Khóa API để trống thì Agent trả 503 AGENT_UNAVAILABLE,
# phần còn lại vẫn chạy. Qua compose, file đã có OPENAI_API_KEY thì không cần thêm LLM_API_KEY.
LLM_API_KEY=
# LLM_PROVIDER=openai          # openai | anthropic | fake (mô hình giả theo luật, cho e2e, không tốn phí)
# LLM_MODEL=gpt-4o-mini

# Cổng trên máy host khi cổng mặc định đã bị chiếm (container vẫn nói chuyện với nhau qua cổng gốc).
# DB_PORT=5432
# VALKEY_PORT=6379
