# Ghi đè cho môi trường development (compose.yaml đã có sẵn giá trị dev mặc định).
# Chép thành `.env` nếu cần. File này KHÔNG dùng cho staging/production — xem deploy/README.md.

# Khóa API của nhà cung cấp LLM; để trống thì Agent trả 503 AGENT_UNAVAILABLE, phần còn lại vẫn chạy.
LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# Cổng trên máy host khi cổng mặc định đã bị chiếm (container vẫn nói chuyện với nhau qua cổng gốc).
# DB_PORT=5432
# VALKEY_PORT=6379
