# Biến cho docker compose trên máy chủ STAGING. Không chứa secret: commit được.
# SITE_DOMAIN là nơi DUY NHẤT khai báo tên miền: PUBLIC_BASE_URL và URL smoke test suy ra từ đây;
# thay tên miền thật trước lần deploy đầu. Workflow tự thêm APP_ENV, IMAGE_REPO; RELEASE do deploy.sh nhận.
COMPOSE_PROJECT_NAME=dacn
SITE_DOMAIN=staging.datlich.example.vn
