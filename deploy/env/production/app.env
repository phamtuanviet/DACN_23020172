# Cấu hình backend + worker cho PRODUCTION (không chứa secret). Secret: xem deploy/README.md.
# APP_ENV và PUBLIC_BASE_URL do compose.prod.yaml truyền vào (suy ra từ deploy.env), không khai báo ở đây.
LOG_LEVEL=INFO
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Quy tắc nghiệp vụ (PRD mục 7)
CLINIC_TZ=Asia/Ho_Chi_Minh
CLINIC_PHONE=
BOOKING_WINDOW_DAYS=30
CHANGE_DEADLINE_HOURS=2
MAX_ACTIVE_APPOINTMENTS=3
PROPOSAL_TTL_MIN=10
AGENT_DAILY_MESSAGE_LIMIT=50
REMINDER_HOURS_BEFORE=24
CHAT_RETENTION_DAYS=365

# LLM (docs mục 6.8)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# Để trống = không dùng mô hình dự phòng (chỉ bật khi mô hình đó đã qua bộ kịch bản đánh giá)
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_S=30
LLM_DAILY_BUDGET_USD=10

# Email qua Amazon SES (TD-28)
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_STARTTLS=true
MAIL_FROM=no-reply@app.dacn-uet-viet.me
